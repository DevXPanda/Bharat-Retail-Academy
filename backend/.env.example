NODE_ENV=development
PORT=5000

# MongoDB (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/ecomedu

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma separated list of frontend origins allowed by CORS
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
PUBLIC_API_URL=http://localhost:5000

# Razorpay (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Live classes: Jitsi as a Service (8x8 JaaS) - recommended for embedding.
# Leave JAAS_* empty to use JITSI_DOMAIN (self hosted Jitsi or meet.jit.si demo).
JITSI_DOMAIN=meet.jit.si
JAAS_APP_ID=
JAAS_KEY_ID=
JAAS_PRIVATE_KEY=

# Business rules

# Email (Resend: https://resend.com/api-keys). Leave RESEND_API_KEY empty in development: codes and links are printed to the server console.
# MAIL_FROM must use a domain you have verified in Resend (the default only delivers to your own Resend account email).
RESEND_API_KEY=
MAIL_FROM=Bharat Retail Academy <no-reply@yourdomain.com>
MAIL_REPLY_TO=
# Public links used inside emails (default to the first three CLIENT_ORIGINS)
PUBLIC_SITE_URL=
TEACHER_PORTAL_URL=
ADMIN_PORTAL_URL=

# Render free tier: the server pings its own public URL every few minutes so it never goes to sleep.
# RENDER_EXTERNAL_URL is set by Render automatically; set KEEP_ALIVE_URL only to override it (leave both empty locally).
KEEP_ALIVE_URL=
KEEP_ALIVE_MINUTES=5
